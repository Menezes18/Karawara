  m_Script: {fileID: 11500000, guid: 05c09aedc36565a4687cba75ecddf3bc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  interactionRange: 3
  player: {fileID: 0}
  dialogBox: {fileID: 1979774481}
  dialogBox2: {fileID: 17097734}
  dialogText: {fileID: 17097736}
  dialogLines:
  - "Voc\xEA fez o imposs\xEDvel, Tainara! O Mapinguari foi derrotado, mas ainda
    temos um \xFAltimo desafio. A Cuca est\xE1 escondida na caverna, e \xE9 l\xE1
    que voc\xEA deve ir agora"
  - "No interior da caverna, h\xE1 tr\xEAs alavancas m\xE1gicas que ela usa para
    controlar o poder das trevas"
  - "Elas est\xE3o bem escondidas, ent\xE3o preste aten\xE7\xE3o. Procure nos buracos,
    nas mesas e nos cantos"
  - "Elas est\xE3o bem escondidas, ent\xE3o preste aten\xE7\xE3o. Procure nos buracos,
    nas mesas e nos cantos"
  - "O ponto de exclama\xE7\xE3o roxo no mapa te guiar\xE1 at\xE9 l\xE1. V\xE1 com
    cautela, e destrua as alavancas para parar a Cuca de uma vez por todas"
  obj: {fileID: 762235938}
